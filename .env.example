# Copy to .env and fill in. Never commit .env.

# --- LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Hindsight memory ---
# Local Docker (docker compose up): http://localhost:8888 (from the backend container it's http://hindsight:8888)
# Hindsight Cloud (ui.hindsight.vectorize.io, promo code MEMHACK99 in billing): paste the API URL + key
HINDSIGHT_URL=http://localhost:8888
# URL the backend CONTAINER uses (docker compose). Set to the Cloud URL if you use Hindsight Cloud.
HINDSIGHT_URL_DOCKER=http://hindsight:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=quickbasket-data-platform
MEMORY_ENABLED=true

# LLM that Hindsight itself uses for fact extraction (local Docker only)
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b

# --- Frontend ---
# true = build the UI against frontend/src/mocks (no backend needed)
VITE_USE_MOCKS=false
